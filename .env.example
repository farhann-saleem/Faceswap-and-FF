# Runtime endpoint secrets only. Never COPY a filled .env into the image.
ALLOW_GENERATE=0
R2_BUCKET=comfy
# Optional R2_BUCKET_NAME alias takes precedence over R2_BUCKET.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=
# Models always come from this bucket; media uses R2_BUCKET.
R2_MODELS_BUCKET=comfy
R2_FACEFUSION_PREFIX=comfy-models/facefusion/3.3.2
R2_OUTPUT_PREFIX=outputs/cpu
# Set to the actual CPU endpoint rate. 0 means unconfigured, not free compute.
RUNPOD_CPU_USD_PER_HR=0
CPU_THREADS=4
FFMPEG_TIMEOUT_SECONDS=1800
MAX_INPUT_BYTES=2147483648
DISK_RESERVE_BYTES=1073741824
